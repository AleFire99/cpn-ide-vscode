{
  "name": "cpn-ide-vscode",
  "displayName": "CPN IDE",
  "description": "Edit, validate and simulate Coloured Petri Nets (CPN Tools .cpn models or plain-text .petri.json) with the bundled CPN IDE editor and simulator.",
  "version": "0.7.0",
  "publisher": "AleFire99",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleFire99/cpn-ide-vscode.git"
  },
  "homepage": "https://github.com/AleFire99/cpn-ide-vscode#readme",
  "bugs": {
    "url": "https://github.com/AleFire99/cpn-ide-vscode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f3a5f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "petri net",
    "petri nets",
    "coloured petri nets",
    "colored petri nets",
    "cpn",
    "cpn tools",
    "cpn ide",
    "simulation",
    "modeling",
    "formal methods",
    "concurrency",
    "sml"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:cpnIde.editor",
    "onCustomEditor:cpnIde.petriEditor",
    "workspaceContains:**/*.cpn",
    "workspaceContains:**/*.petri.json",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cpnml",
        "aliases": [
          "CPN ML"
        ],
        "extensions": [
          ".sml"
        ],
        "configuration": "./language-configuration.cpnml.json"
      }
    ],
    "grammars": [
      {
        "language": "cpnml",
        "scopeName": "source.cpnml",
        "path": "./syntaxes/cpnml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cpnIde.open",
        "title": "CPN IDE: Open Blank Panel"
      },
      {
        "command": "cpnIde.runSimulation",
        "title": "CPN IDE: Run Simulation (No UI)",
        "icon": "$(debug-alt)"
      },
      {
        "command": "cpnIde.simulateLens",
        "title": "CPN IDE: Simulate 100 Steps"
      },
      {
        "command": "cpnIde.clearSimulationResults",
        "title": "CPN IDE: Clear Simulation Results"
      },
      {
        "command": "cpnIde.newNet",
        "title": "CPN IDE: New Net",
        "icon": "$(new-file)"
      },
      {
        "command": "cpnIde.openExample",
        "title": "CPN IDE: Open Example"
      },
      {
        "command": "cpnIde.openInCpnIde",
        "title": "CPN IDE: Open in CPN IDE",
        "icon": "$(play)"
      },
      {
        "command": "cpnIde.convertToText",
        "title": "CPN IDE: Convert to Text Model",
        "icon": "$(file-code)"
      },
      {
        "command": "cpnIde.openAsText",
        "title": "CPN IDE: Reopen as XML Text",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cpnIde.startBackend",
        "title": "CPN IDE: Start Backend"
      },
      {
        "command": "cpnIde.stopBackend",
        "title": "CPN IDE: Stop Backend"
      },
      {
        "command": "cpnIde.restartBackend",
        "title": "CPN IDE: Restart Backend"
      },
      {
        "command": "cpnIde.startDockerBackend",
        "title": "CPN IDE: Start Docker Backend"
      },
      {
        "command": "cpnIde.stopDockerBackend",
        "title": "CPN IDE: Stop Docker Backend"
      },
      {
        "command": "cpnIde.statusMenu",
        "title": "CPN IDE: Backend Status"
      },
      {
        "command": "cpnIde.showLog",
        "title": "CPN IDE: Show Backend Log"
      },
      {
        "command": "cpnIde.exportCpn",
        "title": "CPN IDE: Export .cpn",
        "icon": "$(export)"
      },
      {
        "command": "cpnIde.analyse",
        "title": "CPN IDE: Analyse",
        "icon": "$(play)"
      },
      {
        "command": "cpnIde.checkModel",
        "title": "CPN IDE: Check Model",
        "icon": "$(check)"
      },
      {
        "command": "cpnIde.structuralAnalysis",
        "title": "CPN IDE: Structural Analysis",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "cpnIde.analyseStateSpace",
        "title": "CPN IDE: Analyse State Space",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cpnIde.saveAnalysisReport",
        "title": "CPN IDE: Save Analysis Report",
        "icon": "$(save)"
      },
      {
        "command": "cpnIde.runReplications",
        "title": "CPN IDE: Run Replications",
        "icon": "$(run-all)"
      },
      {
        "command": "cpnIde.exportEventLog",
        "title": "CPN IDE: Export Event Log (CSV/XES)",
        "icon": "$(output)"
      },
      {
        "command": "cpnIde.refreshModels",
        "title": "CPN IDE: Refresh Models",
        "icon": "$(refresh)"
      },
      {
        "command": "cpnIde.openSettings",
        "title": "CPN IDE: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "configuration": [
      {
        "title": "CPN IDE",
        "properties": {
          "cpnIde.eventLog.caseId": {
            "type": "string",
            "default": "i",
            "markdownDescription": "Name of the case id variable used when exporting an event log (play-out)."
          },
          "cpnIde.eventLog.startDateTime": {
            "type": "string",
            "default": "2022-01-01T00:00",
            "markdownDescription": "Start date and time of the exported event log, as `YYYY-MM-DDTHH:mm`."
          },
          "cpnIde.eventLog.timeUnit": {
            "type": "string",
            "default": "hours",
            "enum": [
              "years",
              "months",
              "weeks",
              "days",
              "hours",
              "minutes",
              "seconds"
            ],
            "markdownDescription": "What one simulated time unit means in the exported event log."
          },
          "cpnIde.eventLog.recordedEvents": {
            "type": "string",
            "default": "start+complete",
            "enum": [
              "start",
              "complete",
              "start+complete",
              "in transition name"
            ],
            "markdownDescription": "Which lifecycle events the exported event log records."
          },
          "cpnIde.eventLog.informationLevelIsEvent": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Event-level (on) or case-level (off) information in the exported event log."
          },
          "cpnIde.codeLens.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show the **Simulate**, **Open in CPN IDE** and **Export .cpn** CodeLenses at the top of `*.petri.json` files."
          },
          "cpnIde.stateSpace.maxStates": {
            "type": "number",
            "default": 100000,
            "minimum": 1,
            "markdownDescription": "Analyse State Space stops after this many states and reports the result as Inconclusive."
          },
          "cpnIde.stateSpace.timeoutSeconds": {
            "type": "number",
            "default": 30,
            "minimum": 1,
            "markdownDescription": "Analyse State Space stops after this many seconds and reports the result as Inconclusive."
          },
          "cpnIde.simulation.animate": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Animate token movement during simulation in the CPN IDE UI. Turn off for faster simulation. Applies when an editor is (re)opened."
          },
          "cpnIde.theme": {
            "type": "string",
            "enum": [
              "auto",
              "light"
            ],
            "enumDescriptions": [
              "Follow the VS Code colour theme: dark and high-contrast themes get a dark canvas, panels and toolbar.",
              "Always use the CPN IDE's own light look, even in a dark VS Code theme."
            ],
            "default": "auto",
            "markdownDescription": "Colour theme of the CPN IDE UI. Applies when an editor is (re)opened."
          }
        }
      },
      {
        "title": "CPN IDE: Advanced",
        "properties": {
          "cpnIde.debug": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Keep the CPN IDE UI's verbose `console.log` output (full request/response payloads) in the webview developer tools."
          },
          "cpnIde.port": {
            "type": "number",
            "default": 0,
            "markdownDescription": "Port for the local backend. `0` picks a free port automatically."
          },
          "cpnIde.javaPath": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to a Java 17+ executable. Leave empty to use `JAVA_HOME`, `java` on the PATH, or an automatically downloaded runtime."
          },
          "cpnIde.backendUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "URL of an external CPN IDE backend (for example the Docker image `ghcr.io/alefire99/cpn-ide-backend`). Leave empty to use the bundled local backend."
          },
          "cpnIde.simulation.stepDelayMs": {
            "type": "number",
            "default": 100,
            "minimum": 0,
            "markdownDescription": "Delay in milliseconds between steps of a multi-step simulation in the CPN IDE UI (upstream: 500). Applies when an editor is (re)opened."
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.petri.json",
        "url": "./schema/petri.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/petri.code-snippets"
      },
      {
        "language": "cpnml",
        "path": "./snippets/cpnml.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "cpnIde.editor",
        "displayName": "CPN IDE",
        "selector": [
          {
            "filenamePattern": "*.cpn"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "cpnIde.petriEditor",
        "displayName": "CPN IDE (Petri model)",
        "selector": [
          {
            "filenamePattern": "*.petri.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cpnIde",
          "title": "CPN IDE",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "cpnIde": [
        {
          "id": "cpnIde.models",
          "name": "Models",
          "icon": "media/activity-icon.svg"
        },
        {
          "id": "cpnIde.net",
          "name": "Net",
          "icon": "media/activity-icon.svg"
        },
        {
          "id": "cpnIde.analysis",
          "name": "Analysis",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cpnIde.analysis",
        "contents": "No results yet. Open a .cpn or .petri.json model, then run all the checks in one go: validation, structural analysis and the state space.\n[Analyse](command:cpnIde.analyse)"
      },
      {
        "view": "cpnIde.net",
        "contents": "Open a .petri.json text model to see its pages, places, transitions and arcs."
      },
      {
        "view": "cpnIde.models",
        "contents": "No folder is open. Open one to list its Coloured Petri Net models.\n[Open Folder](command:vscode.openFolder)\n[Open an Example](command:cpnIde.openExample)",
        "when": "workbenchState == empty"
      },
      {
        "view": "cpnIde.models",
        "contents": "No .cpn or .petri.json models in this workspace yet.\n[New Net](command:cpnIde.newNet)\n[Open an Example](command:cpnIde.openExample)",
        "when": "workbenchState != empty"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with CPN IDE",
        "description": "Open, simulate and write Coloured Petri Nets in VS Code.",
        "steps": [
          {
            "id": "openExample",
            "title": "Open an example",
            "description": "Copy one of the bundled example models into your workspace and open it in the CPN IDE canvas. The first time, the backend starts (and Java 17 is downloaded if none is found); the project console then reports **Model is correct**.\n[Open an Example](command:cpnIde.openExample)",
            "media": {
              "image": "media/walkthrough/open-example.png",
              "altText": "An example net open in the CPN IDE canvas"
            },
            "completionEvents": [
              "onCommand:cpnIde.openExample"
            ]
          },
          {
            "id": "simulate",
            "title": "Simulate it",
            "description": "Click **Start simulation** in the CPN IDE toolbar. Enabled transitions turn green: click one to fire it, or use **Multi-Step** in the Simulation panel. Markings are shown next to each place.\nFor a quick check without the UI, simulate the open model for N steps and read the final marking:\n[Run Without the UI](command:cpnIde.runSimulation)",
            "media": {
              "image": "media/walkthrough/simulate.png",
              "altText": "A simulation in progress, with enabled transitions highlighted"
            }
          },
          {
            "id": "newNet",
            "title": "Write your own net",
            "description": "A net can be plain text: NAME.petri.json for places, transitions and arcs, NAME.sml for colour sets and variables. Edit the JSON (with completion from the schema) and the canvas follows; errors appear in the Problems panel.\n[Create a Net](command:cpnIde.newNet)",
            "media": {
              "image": "media/walkthrough/text-model.png",
              "altText": "A text model next to its diagram"
            },
            "completionEvents": [
              "onCommand:cpnIde.newNet"
            ]
          },
          {
            "id": "analyse",
            "title": "Analyse your net",
            "description": "Open the **Analysis** view in the CPN IDE sidebar and press **Analyse**: it checks the model, runs the structural analysis and explores the state space, stopping early if the check finds errors. Try it on 05-dining-philosophers (a dead marking) or 06-unbounded-producer (an unbounded place).\n[Open an Example](command:cpnIde.openExample)",
            "media": {
              "image": "media/walkthrough/analysis.png",
              "altText": "Analysis results for the dining philosophers"
            }
          },
          {
            "id": "linux",
            "title": "Linux: install 32-bit glibc",
            "description": "The CPN simulator needs the 32-bit C library. Install it once, then reopen your model.\n[Show Backend Log](command:cpnIde.showLog)",
            "media": {
              "markdown": "media/walkthrough/linux.md"
            },
            "when": "isLinux"
          },
          {
            "id": "macos",
            "title": "macOS: use the Docker backend",
            "description": "The simulator cannot run on macOS. Start the backend in Docker (Docker must be installed and running); the extension points itself at it.\n[Start Docker Backend](command:cpnIde.startDockerBackend)\nOr set the URL of a backend you started yourself:\n[Set the Backend URL](command:workbench.action.openSettings?%5B%22cpnIde.backendUrl%22%5D)",
            "media": {
              "markdown": "media/walkthrough/macos.md"
            },
            "when": "isMac"
          },
          {
            "id": "settings",
            "title": "Tune the settings",
            "description": "Make multi-step runs faster, turn off the token animation, or choose which Java and backend to use.\n[Open CPN IDE Settings](command:workbench.action.openSettings?%5B%22cpnIde%22%5D)",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cpnIde.openInCpnIde",
          "when": "(resourceExtname =~ /^\\.cpn$/i && activeCustomEditorId != cpnIde.editor) || (resourceFilename =~ /\\.petri\\.json$/i && activeCustomEditorId != cpnIde.petriEditor)",
          "group": "navigation"
        },
        {
          "command": "cpnIde.convertToText",
          "when": "resourceExtname =~ /^\\.cpn$/i",
          "group": "navigation"
        },
        {
          "command": "cpnIde.openAsText",
          "when": "activeCustomEditorId == cpnIde.editor || activeCustomEditorId == cpnIde.petriEditor",
          "group": "navigation"
        },
        {
          "command": "cpnIde.exportCpn",
          "when": "resourceFilename =~ /\\.petri\\.json$/i",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "cpnIde.newNet",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "cpnIde.openInCpnIde",
          "when": "resourceExtname =~ /^\\.cpn$/i || resourceFilename =~ /\\.petri\\.json$/i",
          "group": "navigation"
        },
        {
          "command": "cpnIde.exportCpn",
          "when": "resourceFilename =~ /\\.petri\\.json$/i",
          "group": "navigation"
        },
        {
          "command": "cpnIde.convertToText",
          "when": "resourceExtname =~ /^\\.cpn$/i",
          "group": "navigation"
        },
        {
          "command": "cpnIde.runSimulation",
          "when": "resourceExtname =~ /^\\.cpn$/i || resourceFilename =~ /\\.petri\\.json$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cpnIde.simulateLens",
          "when": "false"
        },
        {
          "command": "cpnIde.clearSimulationResults",
          "when": "false"
        },
        {
          "command": "cpnIde.openAsText",
          "when": "activeCustomEditorId == cpnIde.editor || activeCustomEditorId == cpnIde.petriEditor"
        },
        {
          "command": "cpnIde.exportCpn",
          "when": "resourceFilename =~ /\\.petri\\.json$/i"
        },
        {
          "command": "cpnIde.refreshModels",
          "when": "false"
        },
        {
          "command": "cpnIde.openSettings",
          "when": "false"
        },
        {
          "command": "cpnIde.startBackend",
          "when": "false"
        },
        {
          "command": "cpnIde.stopBackend",
          "when": "false"
        },
        {
          "command": "cpnIde.restartBackend",
          "when": "false"
        },
        {
          "command": "cpnIde.startDockerBackend",
          "when": "false"
        },
        {
          "command": "cpnIde.stopDockerBackend",
          "when": "false"
        },
        {
          "command": "cpnIde.open",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "cpnIde.analyse",
          "when": "view == cpnIde.analysis",
          "group": "navigation@1"
        },
        {
          "command": "cpnIde.saveAnalysisReport",
          "when": "view == cpnIde.analysis",
          "group": "navigation@2"
        },
        {
          "command": "cpnIde.runReplications",
          "when": "view == cpnIde.analysis",
          "group": "analysis@1"
        },
        {
          "command": "cpnIde.exportEventLog",
          "when": "view == cpnIde.analysis",
          "group": "analysis@2"
        },
        {
          "command": "cpnIde.newNet",
          "when": "view == cpnIde.models",
          "group": "navigation@1"
        },
        {
          "command": "cpnIde.refreshModels",
          "when": "view == cpnIde.models",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "cpnIde.runSimulation",
          "when": "view == cpnIde.models && (viewItem == cpn || viewItem == petri)",
          "group": "inline@1"
        },
        {
          "command": "cpnIde.convertToText",
          "when": "view == cpnIde.models && viewItem == cpn",
          "group": "inline@2"
        },
        {
          "command": "cpnIde.exportCpn",
          "when": "view == cpnIde.models && viewItem == petri",
          "group": "inline@2"
        },
        {
          "command": "cpnIde.openInCpnIde",
          "when": "view == cpnIde.models && viewItem != sml",
          "group": "1_open@1"
        },
        {
          "command": "cpnIde.runSimulation",
          "when": "view == cpnIde.models && (viewItem == cpn || viewItem == petri)",
          "group": "2_run@1"
        },
        {
          "command": "cpnIde.convertToText",
          "when": "view == cpnIde.models && viewItem == cpn",
          "group": "3_convert@1"
        },
        {
          "command": "cpnIde.exportCpn",
          "when": "view == cpnIde.models && viewItem == petri",
          "group": "3_convert@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "compile:test": "tsc -p test/integration/tsconfig.json",
    "test:integration": "node esbuild.mjs && tsc -p test/integration/tsconfig.json && node out/test/integration/run.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fast-xml-parser": "^5.11.2",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "javascript-lp-solver": "^0.4.24",
    "jsonc-parser": "^3.3.1"
  }
}
